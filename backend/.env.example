# CodeLab Desktop — Backend Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env
# 2. Fill in every REPLACE_ME value before running the server
# ─────────────────────────────────────────────────────────────────────────────

# ── AI assistance ─────────────────────────────────────────────────────────────
# Required for the AI panel. Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Server ────────────────────────────────────────────────────────────────────
# Port the backend listens on. Must match PORT in electron-codeit/main.js.
PORT=58483

# CORS allowed origins (comma-separated).
# "null" covers Electron's file:// renderer in production builds.
CORS_ORIGINS=http://localhost:3000,http://localhost:58483,null

# ── Rate limiting for /api/files/run ─────────────────────────────────────────
# Token-bucket: allows RUN_RATE executions per RUN_PER seconds.
RUN_RATE=10
RUN_PER=60

# ── Encryption (AES-256-GCM) ──────────────────────────────────────────────────
# Base64-encoded 32-byte key used by /api/files/write-secure and read-secure.
# Generate once:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: changing this key makes previously encrypted files unreadable.
ENCRYPTION_KEY=REPLACE_ME

# ── TCP Status Server ─────────────────────────────────────────────────────────
# Diagnostic TCP server on this port. Set to 0 to disable.
TCP_PORT=8001
