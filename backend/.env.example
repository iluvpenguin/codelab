# CodeIT Desktop — Backend Configuration Example
# Rename this file to .env and fill in your values.

# ── AI assistance ─────────────────────────────────────────────────────────────
# Required for the AI panel. Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=58483
CORS_ORIGINS=*

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max command runs per RUN_PER seconds on /api/files/run
RUN_RATE=10
RUN_PER=60
