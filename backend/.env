# CodeLab Desktop — Backend Configuration
# Copy this file to .env and fill in the values.

# ── AI assistance ─────────────────────────────────────────────────────────────
# Required for the AI panel. Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the backend listens on. Must match PORT constant in main.js.
PORT=58483

# CORS allowed origins. Use * for local desktop use.
# For team setups list specific origins: http://localhost:3000,http://localhost:58483
# Restrict to known local origins.
# "null" covers Electron's file:// renderer in production.
# Add http://localhost:3000 for the CRA dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:58483,null

# ── Rate limiting for /api/files/run ─────────────────────────────────────────
# Max command executions per RUN_PER seconds (token bucket).
RUN_RATE=10
RUN_PER=60

# ── Encryption (AES-256-GCM) ──────────────────────────────────────────────────
# Base64-encoded 32-byte key for /api/files/write-secure and /api/files/read-secure.
# Generate a new key: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: if you change this key, previously encrypted files become unreadable.
ENCRYPTION_KEY=REPLACE_ME

# ── TCP Status Server ─────────────────────────────────────────────────────────
# Port for the raw TCP diagnostic server. Set to 0 to disable.
TCP_PORT=8001
